{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci/run_integration_tests\\.sh$/"],
      "matchStrings": ["\\s(?<depName>node):(?<currentValue>\\S+)\\s"],
      "datasourceTemplate": "docker"
    }
  ]
}
